---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page Not Found"
  description="That page could not be found. Explore the Le Marché Bleu menu, market, and catering pages."
>
  <section class="section center" style="padding-top: 6rem; padding-bottom: 6rem;">
    <div class="container">
      <h1><span class="script-accent">Oh là là</span>Page not found</h1>
      <p class="lead">
        That page seems to have wandered off. Try the menu, the market, or
        head back home.
      </p>
      <p style="margin-top: 2rem;">
        <a class="btn-order" href="/">Back to home</a>
      </p>
    </div>
  </section>
</Base>
