---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Merci!"
  description="Your catering inquiry has been received — a member of the Le Marché Bleu team will follow up shortly."
>
  <section class="section center" style="padding-top: 6rem; padding-bottom: 6rem;">
    <div class="container">
      <h1><span class="script-accent">merci beaucoup</span>Inquiry received</h1>
      <p class="lead">
        Thank you! A member of our team will reach out shortly to confirm
        the details of your event, your menu, and payment.
      </p>
      <p style="margin-top: 2rem;">
        <a class="btn-order" href="/">Back to home</a>
      </p>
    </div>
  </section>
</Base>
